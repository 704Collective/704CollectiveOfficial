# Environment variables required to run the app locally.
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=
ADMIN_INVITE_SECRET=

# --- Stripe (LIVE keys in production; use test keys locally if possible) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SOCIAL_PRICE_ID=
STRIPE_SOCIAL_PRODUCT_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_BUSINESS_ANNUAL_PRICE_ID=

# --- Resend ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- Upstash Redis (rate limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sentry (error monitoring) ---
NEXT_PUBLIC_SENTRY_DSN=
