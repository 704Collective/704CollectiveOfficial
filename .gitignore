# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# build + audit artifacts
build-output*.txt
*.tmp
*_audit_scan.txt
*_preview.html
homepage-dump.txt
notif_tables.txt
# one-off patch/utility scripts (keep source in src/ and supabase/)
/fix_*.py
/patch_*.py
/write_*.py
# one-off rehearsal/probe harnesses. Root-anchored on purpose: the keepers live
# in scripts/ and are never matched by these.
/amb-*.mjs
/cleanup-*.mjs
/drill-*.mjs
/fri-*.mjs
/r1b-*.mjs
/r2b-*.mjs
/r2v-*.mjs
/r3b-*.mjs
/r5b-*.mjs
/w[0-9]*-*.mjs
/w[0-9]*-*.py
/w[0-9]*-*.ps1
# agent working reports
/cursor_report*.md
# data dumps
/all_uids.json
/gm_dates.json
/groupme_notifs.json
/openapi_spec.json
/response_body.json
/test_notifs.json

# test artifacts (local browser-test scripts, screenshots, outputs)
test-assets/
e2e/screenshots/
.tmp-*.png
scripts/test-*.mjs

# member-data reports — never commit
outputs/

# Supabase CLI cache + local schema scratch
supabase/.temp/
supabase/schemas/
